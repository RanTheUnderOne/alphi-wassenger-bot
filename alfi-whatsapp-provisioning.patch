diff --git a/scripts/generate-alfi-bundle.mjs b/scripts/generate-alfi-bundle.mjs
new file mode 100644
index 0000000..b4b05e9
--- /dev/null
+++ b/scripts/generate-alfi-bundle.mjs
@@ -0,0 +1,33 @@
+#!/usr/bin/env node
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const source = path.join(root, "agent", "alfi-structure");
+const output = path.join(root, "src", "generated", "alfi-bundle.ts");
+
+function walk(dir) {
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
+    const full = path.join(dir, entry.name);
+    return entry.isDirectory() ? walk(full) : [full];
+  });
+}
+
+const files = walk(source)
+  .filter((file) => {
+    const relative = path.relative(source, file).replaceAll("\\", "/");
+    return relative === "SOUL.md" || relative.startsWith("skills/");
+  })
+  .map((file) => ({
+    path: path.relative(source, file).replaceAll("\\", "/"),
+    base64: fs.readFileSync(file).toString("base64"),
+  }));
+
+fs.mkdirSync(path.dirname(output), { recursive: true });
+fs.writeFileSync(
+  output,
+  `// Generated by scripts/generate-alfi-bundle.mjs. Do not edit.\n` +
+    `export const ALFI_BUNDLE = ${JSON.stringify(files, null, 2)} as const;\n`
+);
+console.log(`Generated ${files.length} Alfi files.`);
